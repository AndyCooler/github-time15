<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Edge-to-edge items -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Ensure dark icons on light background for navigation bar (API 27+) -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- This applies the default style to ALL MaterialToolbars in your app -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>

    <!-- Default Toolbar Style -->
    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.PrimarySurface">
        <item name="android:background">#536DFE</item>
        <item name="android:theme">@style/ThemeOverlay.App.ToolbarContent</item>
        <item name="popupTheme">@style/ThemeOverlay.App.PopupMenu</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Theme Overlay for Toolbar CONTENTS -->
    <style name="ThemeOverlay.App.ToolbarContent" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="colorControlNormal">@android:color/white</item>
        <item name="actionMenuTextColor">@android:color/white</item>
    </style>

    <!-- Theme Overlay for Popup Menu -->
    <style name="ThemeOverlay.App.PopupMenu" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:background">#536DFE</item>
        <item name="android:textColorPrimary">@android:color/white</item>
    </style>

</resources>
